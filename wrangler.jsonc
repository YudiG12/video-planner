{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  // SPA + API in one Worker; /api and /mcp hit the Worker first
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/mcp"] },
  // `npm run setup` fills database_id
  "d1_databases": [{ "binding": "DB", "database_name": "video-planner", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations" }],
  // Secrets (wrangler secret put): AGENT_TOKEN, ACCESS_TEAM_DOMAIN, ACCESS_AUD, CHANNEL_NAME, CHANNEL_HANDLE, AVATAR_URL
  "observability": { "enabled": true }
}
